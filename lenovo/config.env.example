# ======================================================
# Configuración del puente (Lenovo)
# Copia este archivo como  config.env  y llena tus datos:
#   cp lenovo/config.env.example lenovo/config.env
#   nano lenovo/config.env
# ======================================================

# --- Broker EMQX en la nube (pestaña "Overview" de tu deployment) ---
MQTT_HOST=xxxxxxxx.ala.us-east-1.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=1
# Solo si sale error de certificado (ver README):
# MQTT_CA=/home/TU_USUARIO/robot-iot/lenovo/emqxsl-ca.crt

# --- Usuario creado en "Access Control > Authentication" ---
MQTT_USER=robot
MQTT_PASS=cambia-esta-clave

# --- Puerto USB de la ESP32 ("auto" lo busca solo) ---
SERIAL_PORT=auto
SERIAL_BAUD=115200

# --- Página que muestra la pantallita del robot ---
CARA_URL=https://tu-proyecto.vercel.app/cara

# Déjalo vacío (solo sirve si compartes broker con otros grupos)
TOPIC_PREFIX=
